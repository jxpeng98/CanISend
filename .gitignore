.DS_Store
.env
# Track Trellis's Claude Code project integration while retaining local-only settings.
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/commands/
!.claude/commands/**
!.claude/hooks/
!.claude/hooks/**
!.claude/skills/
!.claude/skills/**
!.claude/settings.json
.idea/
.vscode/

/target/
/spikes/*/target/
/fuzz/target/
/fuzz/artifacts/
/fuzz/corpus/
/dist/
/build/
/apps/*/dist/
/apps/*/node_modules/
/apps/*/playwright-report/
/apps/*/test-results/
/crates/canisend-desktop/gen/

/.canisend/
/jobs/
/profile/
/job_leads/
*.sqlite3-shm
*.sqlite3-wal

# Python is used only by Trellis development control; never track its caches or virtualenvs.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
