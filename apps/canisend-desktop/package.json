{
  "name": "@canisend/desktop-ui",
  "version": "1.0.0-beta.1",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.5.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "format:check": "prettier --check \"src/**/*.{svelte,ts}\" \"tests/**/*.ts\" \"*.{ts,js,json}\"",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:accessibility": "playwright test tests/visual/application-shell.a11y.spec.ts tests/visual/ui-system.a11y.spec.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "macos:preview": "../../scripts/build_macos_design_preview.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "1.27.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "bits-ui": "2.18.1",
    "clsx": "2.1.1",
    "mode-watcher": "1.1.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@internationalized/date": "3.12.2",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "shadcn-svelte": "1.4.2",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "tailwind-variants": "3.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
