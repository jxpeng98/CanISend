{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CanISend Next",
  "version": "1.0.0-alpha.3",
  "identifier": "io.github.jxpeng98.canisend.desktop-next",
  "build": {
    "beforeDevCommand": "pnpm --dir ../apps/canisend-desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../apps/canisend-desktop build",
    "frontendDist": "../../apps/canisend-desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CanISend Next",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "app"
    ],
    "icon": [
      "../../packaging/macos/AppIcon.icns"
    ]
  }
}
