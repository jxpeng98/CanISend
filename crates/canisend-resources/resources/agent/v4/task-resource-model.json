{
  "format": "canisend.agent-task-resource-model/v4",
  "protocol": "canisend.agent/v4",
  "workspace_format": "canisend.workspace/v4",
  "tasks": [
    {
      "task": "orientation",
      "description": "Inspect Workspace health, Packs, Applications, and the next bounded action without reading private bodies.",
      "operation_prefixes": ["workspace.status", "application.list", "application.show"],
      "mutation": false,
      "phases": ["orient", "verify"],
      "workspace_only_allowed": true
    },
    {
      "task": "profile-evidence",
      "description": "Manage the minimum Workspace Profile and user-confirmed reusable Evidence.",
      "operation_prefixes": ["profile.", "evidence.list", "evidence.show", "evidence.propose.", "evidence.confirm."],
      "mutation": true,
      "phases": ["orient", "propose", "preview", "approve", "commit", "verify"],
      "workspace_only_allowed": true
    },
    {
      "task": "intake",
      "description": "Import a bounded Source and create explicit Source-to-Application associations.",
      "operation_prefixes": ["source.intake.", "source.association.", "source.list", "source.show"],
      "mutation": true,
      "phases": ["orient", "propose", "preview", "approve", "commit", "verify"],
      "workspace_only_allowed": false
    },
    {
      "task": "application-create",
      "description": "Create an Application with one exact Application-level Pack binding.",
      "operation_prefixes": ["application.create."],
      "mutation": true,
      "phases": ["orient", "propose", "preview", "approve", "commit", "verify"],
      "workspace_only_allowed": true
    },
    {
      "task": "requirements",
      "description": "Propose, correct, and confirm Source-grounded Requirements.",
      "operation_prefixes": ["requirement."],
      "mutation": true,
      "phases": ["orient", "propose", "preview", "approve", "commit", "verify"],
      "workspace_only_allowed": false
    },
    {
      "task": "fit-plan",
      "description": "Analyze confirmed Evidence against Requirements and commit the user decision and Plan.",
      "operation_prefixes": ["plan.", "evidence.association."],
      "mutation": true,
      "phases": ["orient", "propose", "preview", "approve", "commit", "verify"],
      "workspace_only_allowed": false
    },
    {
      "task": "drafting",
      "description": "Draft Pack-qualified Deliverables from confirmed Evidence and the current Plan.",
      "operation_prefixes": ["deliverable."],
      "mutation": true,
      "phases": ["orient", "propose", "preview", "approve", "commit", "verify"],
      "workspace_only_allowed": false
    },
    {
      "task": "review",
      "description": "Audit Deliverables for Evidence support and record explicit review dispositions.",
      "operation_prefixes": ["review."],
      "mutation": true,
      "phases": ["orient", "propose", "preview", "approve", "commit", "verify"],
      "workspace_only_allowed": false
    },
    {
      "task": "export",
      "description": "Render and export reviewed Deliverables without uploading or submitting them.",
      "operation_prefixes": ["export."],
      "mutation": true,
      "phases": ["orient", "propose", "preview", "approve", "commit", "verify"],
      "workspace_only_allowed": false
    },
    {
      "task": "recovery",
      "description": "Recover from stale revisions, denied consent, malformed output, restart, or Workspace damage.",
      "operation_prefixes": ["workspace.check", "workspace.backup.", "workspace.restore.", "workspace.repair."],
      "mutation": true,
      "phases": ["orient", "propose", "preview", "approve", "commit", "verify"],
      "workspace_only_allowed": true
    }
  ],
  "authority": "canisend-application-facade",
  "transport_preference": ["mcp", "native-cli"],
  "direct_internal_writes_allowed": false,
  "submission_supported": false,
  "legacy_compatibility_supported": false
}
