    },
    "operation": {
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/AgentProtocolV4"
    },
    "request_sha256": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "task_id",
    "operation",
    "context",
    "request_sha256",
    "candidate_schema",
    "candidate_sha256",
    "summary"
  ],
  "title": "AgentProposalV4",
  "type": "object",
  "x-canisend-id": "canisend.agent-proposal/v4",
  "x-canisend-version": "4.0.0"
