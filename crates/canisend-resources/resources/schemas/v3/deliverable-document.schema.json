{
  "$defs": {
    "ContentRevisionReferenceV3": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "type": "object"
    },
    "DeliverableDocumentFormatV3": {
      "enum": [
        "canisend.deliverable-document/v3"
      ],
      "type": "string"
    },
    "DeliverableFieldV3": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/DeliverableTextV3"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "DeliverableSectionV3": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/DeliverableTextV3"
        },
        "heading": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "body"
      ],
      "type": "object"
    },
    "DeliverableTextRoleV3": {
      "description": "The reviewer checks this classification; the kernel verifies its declared citations.",
      "enum": [
        "evidence-bound",
        "requirement-bound",
        "intent",
        "non-factual"
      ],
      "type": "string"
    },
    "DeliverableTextV3": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ContentRevisionReferenceV3"
          },
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/RequirementRevisionReferenceV3"
          },
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/DeliverableTextRoleV3"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "role",
        "evidence",
        "requirements"
      ],
      "type": "object"
    },
    "RequirementRevisionReferenceV3": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.canisend.dev/v3/deliverable-document.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable data, never Typst or Markdown code. Each field and section body has an explicit\nprovenance classification. Missing facts can be drafted but cannot pass readiness validators.",
  "properties": {
    "fields": {
      "items": {
        "$ref": "#/$defs/DeliverableFieldV3"
      },
      "type": "array"
    },
    "format": {
      "$ref": "#/$defs/DeliverableDocumentFormatV3"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/DeliverableSectionV3"
      },
      "type": "array"
    },
    "unresolved_fields": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "format",
    "fields",
    "sections",
    "unresolved_fields"
  ],
  "title": "DeliverableDocumentV3",
  "type": "object",
  "x-canisend-id": "canisend.deliverable-document/v3",
  "x-canisend-version": "3.0.0"
}
