{
  "$defs": {
    "ApplicationPackBindingV3": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_digest"
      ],
      "type": "object"
    },
    "ContentRevisionReferenceV3": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "type": "object"
    },
    "DeliverableStateV3": {
      "enum": [
        "planned",
        "draft",
        "review-required",
        "approved",
        "stale"
      ],
      "type": "string"
    },
    "EntityRevisionReferenceV3": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "PlanRevisionReferenceV3": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.canisend.dev/v3/deliverable.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentRevisionReferenceV3"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_inputs": {
      "items": {
        "$ref": "#/$defs/EntityRevisionReferenceV3"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "media_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "pack": {
      "$ref": "#/$defs/ApplicationPackBindingV3"
    },
    "plan": {
      "$ref": "#/$defs/PlanRevisionReferenceV3"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/DeliverableStateV3"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "application_id",
    "pack",
    "plan",
    "kind",
    "title",
    "state",
    "evidence_inputs",
    "revision"
  ],
  "title": "DeliverableRecordV3",
  "type": "object",
  "x-canisend-id": "canisend.deliverable/v3",
  "x-canisend-version": "3.0.0"
}
