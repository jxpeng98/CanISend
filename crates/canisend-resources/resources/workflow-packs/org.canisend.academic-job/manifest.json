{
  "format": "canisend.workflow-pack/v1",
  "id": "org.canisend.academic-job",
  "version": "1.0.0",
  "schema_version": "1.0.0",
  "publisher": {
    "id": "org.canisend",
    "name": "CanISend",
    "homepage": "https://github.com/jxpeng98/canisend"
  },
  "compatibility": {
    "kernel": ">=1.0.0-alpha.5, <2.0.0",
    "agent": ">=3.0.0-alpha.1, <4.0.0",
    "workspace": ">=3.0.0-alpha.1, <4.0.0"
  },
  "default_locale": "en",
  "locales": {
    "en": {
      "application_singular": "Academic application",
      "application_plural": "Academic applications",
      "opportunity_singular": "Academic position",
      "opportunity_plural": "Academic positions",
      "requirement_plural": "Selection criteria",
      "evidence_plural": "Profile evidence",
      "deliverable_plural": "Application materials"
    },
    "zh-Hans": {
      "application_singular": "学术职位申请",
      "application_plural": "学术职位申请",
      "opportunity_singular": "学术职位",
      "opportunity_plural": "学术职位",
      "requirement_plural": "遴选标准",
      "evidence_plural": "个人证据",
      "deliverable_plural": "申请材料"
    }
  },
  "application": {
    "opportunity_fields": [
      {
        "id": "institution",
        "labels": {"en": "Institution", "zh-Hans": "机构"},
        "field_type": "short-text",
        "required": true,
        "options": []
      }
    ],
    "application_fields": []
  },
  "workflow": {
    "stages": [
      {
        "id": "intake",
        "labels": {"en": "Intake", "zh-Hans": "导入"},
        "depends_on": [],
        "output": "sources",
        "execution_modes": ["manual-import"]
      },
      {
        "id": "parse",
        "labels": {"en": "Parse position", "zh-Hans": "解析职位"},
        "depends_on": ["intake"],
        "output": "none",
        "execution_modes": ["host-agent", "configured-provider"]
      },
      {
        "id": "criteria",
        "labels": {"en": "Confirm criteria", "zh-Hans": "确认标准"},
        "depends_on": ["parse"],
        "output": "requirements",
        "execution_modes": ["user-decision"]
      },
      {
        "id": "evidence",
        "labels": {"en": "Build evidence", "zh-Hans": "整理证据"},
        "depends_on": [],
        "output": "evidence",
        "execution_modes": ["host-agent", "configured-provider"]
      },
      {
        "id": "match",
        "labels": {"en": "Match evidence", "zh-Hans": "匹配证据"},
        "depends_on": ["criteria", "evidence"],
        "output": "matches",
        "execution_modes": ["host-agent", "configured-provider"]
      },
      {
        "id": "plan",
        "labels": {"en": "Confirm plan", "zh-Hans": "确认计划"},
        "depends_on": ["match"],
        "output": "plan",
        "execution_modes": ["user-decision"]
      },
      {
        "id": "draft",
        "labels": {"en": "Draft materials", "zh-Hans": "起草材料"},
        "depends_on": ["plan"],
        "output": "deliverables",
        "execution_modes": ["host-agent", "configured-provider"]
      },
      {
        "id": "review",
        "labels": {"en": "Review materials", "zh-Hans": "审查材料"},
        "depends_on": ["draft"],
        "output": "review",
        "execution_modes": ["host-agent", "configured-provider", "user-decision"]
      },
      {
        "id": "package",
        "labels": {"en": "Package materials", "zh-Hans": "打包材料"},
        "depends_on": ["review"],
        "output": "package",
        "execution_modes": ["deterministic"]
      },
      {
        "id": "render",
        "labels": {"en": "Render and export", "zh-Hans": "渲染与导出"},
        "depends_on": ["package"],
        "output": "render",
        "execution_modes": ["deterministic"]
      }
    ],
    "terminal_stage": "render"
  },
  "requirements": {
    "categories": [
      {"id": "qualification", "labels": {"en": "Qualifications", "zh-Hans": "资历"}, "fields": []},
      {"id": "teaching", "labels": {"en": "Teaching", "zh-Hans": "教学"}, "fields": []},
      {"id": "research", "labels": {"en": "Research", "zh-Hans": "研究"}, "fields": []},
      {"id": "communication", "labels": {"en": "Communication", "zh-Hans": "沟通"}, "fields": []},
      {"id": "leadership", "labels": {"en": "Leadership", "zh-Hans": "领导力"}, "fields": []},
      {"id": "service", "labels": {"en": "Service", "zh-Hans": "学术服务"}, "fields": []},
      {"id": "employment", "labels": {"en": "Employment", "zh-Hans": "工作经历"}, "fields": []},
      {"id": "other", "labels": {"en": "Other", "zh-Hans": "其他"}, "fields": []}
    ]
  },
  "evidence": {
    "categories": [
      {"id": "qualification", "labels": {"en": "Qualifications", "zh-Hans": "资历"}, "fields": []},
      {"id": "teaching", "labels": {"en": "Teaching", "zh-Hans": "教学"}, "fields": []},
      {"id": "research", "labels": {"en": "Research", "zh-Hans": "研究"}, "fields": []},
      {"id": "communication", "labels": {"en": "Communication", "zh-Hans": "沟通"}, "fields": []},
      {"id": "leadership", "labels": {"en": "Leadership", "zh-Hans": "领导力"}, "fields": []},
      {"id": "service", "labels": {"en": "Service", "zh-Hans": "学术服务"}, "fields": []},
      {"id": "employment", "labels": {"en": "Employment", "zh-Hans": "工作经历"}, "fields": []},
      {"id": "other", "labels": {"en": "Other", "zh-Hans": "其他"}, "fields": []}
    ]
  },
  "deliverables": {
    "kinds": [
      {
        "id": "cover-letter",
        "labels": {"en": "Cover letter", "zh-Hans": "求职信"},
        "minimum": 1,
        "maximum": 1,
        "template": "templates/modernpro-coverletter.typ",
        "renderer": "canisend.renderer.typst",
        "validators": ["traceability", "unsupported-claims", "placeholder-free", "citation-integrity", "review-complete"]
      },
      {
        "id": "research-statement",
        "labels": {"en": "Research statement", "zh-Hans": "研究陈述"},
        "minimum": 0,
        "maximum": 1,
        "template": "templates/modernpro-coverletter.typ",
        "renderer": "canisend.renderer.typst",
        "validators": ["traceability", "unsupported-claims", "placeholder-free", "citation-integrity", "review-complete"]
      },
      {
        "id": "teaching-statement",
        "labels": {"en": "Teaching statement", "zh-Hans": "教学陈述"},
        "minimum": 0,
        "maximum": 1,
        "template": "templates/modernpro-coverletter.typ",
        "renderer": "canisend.renderer.typst",
        "validators": ["traceability", "unsupported-claims", "placeholder-free", "citation-integrity", "review-complete"]
      },
      {
        "id": "cv",
        "labels": {"en": "Academic CV", "zh-Hans": "学术简历"},
        "minimum": 1,
        "maximum": 1,
        "template": "templates/modernpro-cv.typ",
        "renderer": "canisend.renderer.typst",
        "validators": ["traceability", "unsupported-claims", "placeholder-free", "citation-integrity", "review-complete"]
      }
    ]
  },
  "capabilities": {
    "intake_adapters": [
      "canisend.intake.local-file",
      "canisend.intake.user-url",
      "canisend.intake.text-pdf",
      "canisend.discovery.rss-atom",
      "canisend.discovery.jobs-ac-uk",
      "canisend.discovery.greenhouse",
      "canisend.discovery.lever"
    ],
    "renderers": ["canisend.renderer.typst"],
    "validators": [
      "canisend.validator.evidence-traceability",
      "canisend.validator.unsupported-claims",
      "canisend.validator.placeholder-free",
      "canisend.validator.citation-integrity",
      "canisend.validator.review-complete"
    ]
  },
